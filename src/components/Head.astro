---
interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const fallbackDescription =
  "XCL is a relational configuration language built on the readability of HCL: references between blocks, graph-based processing, plugins, variables, modules, functions and state. Go implementation available now.";
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description ?? fallbackDescription} />
<script is:inline>
  // Apply the reader's language before the page paints, so every CodeTabs box
  // opens on the stored choice with no flash of Go. "go" is the default, and
  // a browser that blocks storage still gets a working page.
  (function () {
    var lang = "go";
    try {
      if (localStorage.getItem("xcl-lang") === "python") lang = "python";
    } catch (e) {}
    document.documentElement.dataset.lang = lang;
  })();
</script>
