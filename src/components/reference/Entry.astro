---
import Badge from "../Badge.astro";
import Fields from "./Fields.astro";
import type { ReferenceEntry } from "../../lib/reference";

interface Props {
  entry: ReferenceEntry;
  depth?: number;
}

const { entry, depth = 0 } = Astro.props;
const Heading = depth === 0 ? "h3" : "h4";
---
<div id={entry.id} class={`reference-entry ${depth === 0 ? "reference-entry-top" : "reference-entry-member"}`}>
  <div class="flex items-center gap-2 flex-wrap">
    <Heading class="reference-name"><a href={`#${entry.id}`}>{depth === 0 ? entry.id : entry.name}</a></Heading>
    <span class="reference-kind">{entry.kind}</span>
    {depth === 0 && entry.label && <Badge text={entry.label} variant={entry.label === "asyncio" ? "purple" : "green"} />}
    {entry.inheritedFrom && <span class="reference-kind">inherited from {entry.inheritedFrom}</span>}
  </div>

  {entry.signature && <pre class="reference-signature"><code>{entry.signature}</code></pre>}

  {entry.description && <div class="xcl-body reference-description" set:html={entry.description} />}

  <Fields parameters={entry.parameters} returns={entry.returns} raises={entry.raises} />

  {entry.overloads?.length ? (
    <div class="reference-overloads">
      {entry.overloads.map((overload) => (
        <div class="reference-overload">
          <pre class="reference-signature"><code>{overload.signature}</code></pre>
          {overload.description && overload.description !== entry.description && (
            <div class="xcl-body reference-description" set:html={overload.description} />
          )}
          <Fields parameters={overload.parameters} returns={overload.returns} raises={overload.raises} />
        </div>
      ))}
    </div>
  ) : null}

  {entry.members?.length ? (
    <div class="reference-members">
      {entry.members.map((member) => <Astro.self entry={member} depth={depth + 1} />)}
    </div>
  ) : null}
</div>
