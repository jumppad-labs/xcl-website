---
import Badge from "../Badge.astro";
import type { ReferenceEntry } from "../../lib/pythonReference";

interface Props {
  entry: ReferenceEntry;
  depth?: number;
}

const { entry, depth = 0 } = Astro.props;
const Heading = depth === 0 ? "h3" : "h4";
const hasFields = entry.parameters?.length || entry.returns || entry.raises?.length;
---
<div id={entry.id} class={`reference-entry ${depth === 0 ? "reference-entry-top" : "reference-entry-member"}`}>
  <div class="flex items-center gap-2 flex-wrap">
    <Heading class="reference-name"><a href={`#${entry.id}`}>{depth === 0 ? entry.id : entry.name}</a></Heading>
    <span class="reference-kind">{entry.kind}</span>
    {depth === 0 && entry.label && <Badge text={entry.label} variant={entry.label === "asyncio" ? "purple" : "green"} />}
    {entry.inheritedFrom && <span class="reference-kind">inherited from {entry.inheritedFrom}</span>}
  </div>

  {entry.signature && <pre class="reference-signature"><code>{entry.signature}</code></pre>}

  {entry.description && <div class="xcl-body reference-description" set:html={entry.description} />}

  {hasFields && (
    <dl class="reference-fields">
      {entry.parameters?.length ? (
        <>
          <dt>Parameters</dt>
          <dd>
            <ul>
              {entry.parameters.map((parameter) => (
                <li>
                  <code>{parameter.name}</code>
                  {parameter.type && <span class="reference-type"> {parameter.type}</span>}
                  {parameter.default && <span class="reference-type"> = {parameter.default}</span>}
                  {parameter.description && <div class="xcl-body" set:html={parameter.description} />}
                </li>
              ))}
            </ul>
          </dd>
        </>
      ) : null}
      {entry.returns && (
        <>
          <dt>Returns</dt>
          <dd>
            {entry.returns.type && <code>{entry.returns.type}</code>}
            {entry.returns.description && <div class="xcl-body" set:html={entry.returns.description} />}
          </dd>
        </>
      )}
      {entry.raises?.length ? (
        <>
          <dt>Raises</dt>
          <dd>
            <ul>
              {entry.raises.map((raised) => (
                <li>
                  <code>{raised.type}</code>
                  {raised.description && <div class="xcl-body" set:html={raised.description} />}
                </li>
              ))}
            </ul>
          </dd>
        </>
      ) : null}
    </dl>
  )}

  {entry.members?.length ? (
    <div class="reference-members">
      {entry.members.map((member) => <Astro.self entry={member} depth={depth + 1} />)}
    </div>
  ) : null}
</div>
