---
// A link to a name in the Python reference, by its full dotted name. A name
// the reference does not have renders as plain code with a build warning, so a
// release that renames something still reaches the site; the reference check
// workflow sets XCL_REFERENCE_STRICT to make it a failure.
import { hasEntry } from "../lib/pythonReference";

interface Props {
  name: string;
  label?: string;
}

const { name, label } = Astro.props;
const text = label ?? name;
const known = hasEntry(name);

if (!known) {
  const message = `PyRef: the Python reference has no entry named ${name}`;
  if (process.env.XCL_REFERENCE_STRICT === "1") {
    throw new Error(message);
  }
  console.warn(message);
}
---
{known ? <a href={`/reference/python/#${name}`}><code>{text}</code></a> : <code>{text}</code>}
